# ── MarketHub — environment template ──────────────────────────────────────────
# Copy to `.env` and fill in. NEVER commit the real `.env`.
#
#   cp .env.example .env
#
# Every variable below is one the code actually reads. Nothing here is a
# placeholder for an integration that does not exist.

# ── Database (required) ───────────────────────────────────────────────────────
# PostgreSQL connection string. Any Postgres works: Neon, Supabase, RDS, or a
# local `postgres` container.
#
# On serverless (Vercel) use the POOLED connection string for the app, and the
# DIRECT (non-pooler) one when running migrations — a pooler cannot hold the
# session a migration needs.
DATABASE_URL=postgresql://user:password@host:5432/markethub?sslmode=require

# ── Sessions (required) ───────────────────────────────────────────────────────
# Signing key for the session cookie. Generate a strong random value:
#   openssl rand -base64 48
# Changing this invalidates every existing session.
JWT_SECRET=replace-me-with-a-long-random-string

# ── Authentication (optional) ─────────────────────────────────────────────────
# "local" (default) = email/password and phone/password accounts.
# "none"            = no accounts at all; the storefront is browse-only.
# "sso"             = reserved; not implemented in this app.
AUTH_PROVIDER=local

# ── Administrators (recommended) ──────────────────────────────────────────────
# Comma-separated emails promoted to the admin role automatically at signup and
# at every login. This is the ONLY way admin is granted — registering never
# confers it. Put the two authorised admin addresses here.
#
# Leave it empty and instead run:  pnpm admin:grant you@example.com
ADMIN_EMAILS=admin1@example.com,admin2@example.com

# ── Database driver (optional) ────────────────────────────────────────────────
# "tcp"  (default) = node-postgres pool. Right for a resident Node process.
# "http"           = Neon serverless HTTP. Better fit for Vercel functions.
# DB_DRIVER=tcp

# ── Payment gateway (optional) ────────────────────────────────────────────────
# Leave ALL of these unset to use the manual bank-transfer flow, which is what
# the app ships with and what works today. The storefront reads the capability
# check and shows the transfer instructions instead of a gateway button.
#
# To enable a gateway, set the provider and BOTH keys. The SECRET key is read
# server-side only and is never sent to the browser; the public key is safe to
# embed. Payment status changes only after server-side verification.
#
# PAYMENT_PROVIDER=paystack          # or: flutterwave
# PAYSTACK_PUBLIC_KEY=pk_live_xxx
# PAYSTACK_SECRET_KEY=sk_live_xxx
# FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-xxx
# FLUTTERWAVE_SECRET_KEY=FLWSECK-xxx

# ── Product image uploads (optional) ──────────────────────────────────────────
# Only needed for uploading product images from the admin dashboard. Without
# them the admin can still set an image by URL.
# APP_STORAGE_PRESIGN_URL=
# APP_STORAGE_TOKEN=

# ── Local development (optional) ──────────────────────────────────────────────
# PORT=3000
# API_PORT=3001
