# ── MarketHub — environment template ─────────────────────────────────────────
# Copy to `.env` and fill in. NEVER commit the real `.env`.
#
#   cp .env.example .env

# ── Database (required) ──────────────────────────────────────────────────────
# PostgreSQL connection string. Any Postgres works: Supabase, Neon, RDS, or a
# local `postgres` container. Use the POOLED connection string in serverless
# environments.
DATABASE_URL=postgresql://user:password@host:5432/markethub?sslmode=require

# ── Sessions (required) ──────────────────────────────────────────────────────
# Signing key for the session cookie. Generate a strong random value:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-long-random-string

# ── First administrator (recommended) ────────────────────────────────────────
# Comma-separated emails that are promoted to the admin role automatically at
# signup and at every login. This is the zero-touch way to bootstrap the first
# admin without touching the database by hand.
#
# Leave it empty and instead run:  pnpm admin:grant you@example.com
ADMIN_EMAILS=

# ── Storefront ───────────────────────────────────────────────────────────────
# Public base URL, used for absolute links in metadata.
APP_URL=http://localhost:3000

# ── Optional ─────────────────────────────────────────────────────────────────
# Port for the API server (defaults to 3001 in dev).
# PORT=3001
