# Vercel build-context excludes.
#
# Vercel uploads the repo and runs `pnpm install --frozen-lockfile` then
# `pnpm build:web`. Everything here is either regenerated by the build, a local
# secret, or noise that would only slow the upload down.
node_modules
dist
.git
.env
.env.*
!.env.example
.webapp-logs
*.log
coverage
shots
shots2
downloads
