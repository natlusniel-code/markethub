{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "pnpm build:web && pnpm build:vercel",
  "outputDirectory": "dist/public",
  "installCommand": "pnpm install --frozen-lockfile",
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/trpc/(.*)", "destination": "/api/index?__path=/trpc/$1" },
    { "source": "/app-storage/(.*)", "destination": "/api/index?__path=/app-storage/$1" },
    { "source": "/api/health", "destination": "/api/index?__path=/api/health" },
    { "source": "/api/_jobs/(.*)", "destination": "/api/index?__path=/api/_jobs/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
